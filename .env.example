# Copy to .env for local development and generate your own secret.
# Never use the same secret in development and production.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated origins, including scheme; empty is fine for same-origin local use.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set in the process environment to disable local .env loading:
# DJANGO_READ_DOTENV=False

# Empty/unset keeps the local SQLite database.
DATABASE_URL=
# PostgreSQL example only: replace all placeholders in your private environment.
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require

# Production cookies and HTTPS redirect are enabled automatically with DEBUG=False.
# Opt in ONLY after configuring a trusted, header-sanitising reverse proxy.
DJANGO_TRUST_PROXY_SSL_HEADER=False
# Keep 0 until actual HTTPS works; then start with a short trial, e.g. 300 seconds.
DJANGO_SECURE_HSTS_SECONDS=0
